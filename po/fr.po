#: data/app.desktop.in:2 data/app.metainfo.xml.in:4 src/application.vala:275
#: src/main.vala:24
msgid "Gapless"
msgstr "Gapless"

#: data/app.desktop.in:3
msgid "Music Player"
msgstr "Lecteur de musique"

#: data/app.desktop.in:4 data/app.metainfo.xml.in:7
msgid "Play your music elegantly"
msgstr "Jouez votre musique élégamment"

#: data/app.desktop.in:11
msgid "music;sound;player;media;audio;playlist;"
msgstr "musique;son;lecteur;média;audio;liste de lecture;"

#: data/app.metainfo.xml.in:24
msgid ""
"Gapless (AKA: G4Music) is a light weight music player written in GTK4, "
"focuses on large music collection."
msgstr ""
"Gapless (anciennement G4Music) est un lecteur de musique léger écrit avec "
"GTK4, conçu pour de grandes collection de musiques."

#: data/app.metainfo.xml.in:25
msgid "Features"
msgstr "Fonctionnalités"

#: data/app.metainfo.xml.in:27
msgid ""
"Supports most music file types, Samba and any other remote protocols "
"(depends on GIO and GStreamer)."
msgstr ""
"Prend en charge la plupart des types de fichier, Samba et n’importe quel "
"protocole distant (requiert GIO et GStreamer)."

#: data/app.metainfo.xml.in:28
msgid ""
"Fast loading and parsing thousands of music files in very few seconds, "
"monitor local changes."
msgstr ""
"Chargement rapide et analyse de milliers de fichiers de musiques en quelques "
"secondes, tout en surveillant les changements locaux"

#: data/app.metainfo.xml.in:29
msgid ""
"Low memory usage for large music collection with album covers (embedded and "
"external), no thumbnail caches to store."
msgstr ""
"Faible utilisation de la mémoire pour de grandes collections de musiques "
"avec pochettes d’album (intégrées et externes), pas de caches de vignettes à "
"stocker."

#: data/app.metainfo.xml.in:30
msgid ""
"Group and sorts by album/artist/title, shuffle list, full-text searching."
msgstr ""
"Tri par album, artiste ou titre, lecture aléatoire, recherche intégrale à partir "
"d’une saisie."

#: data/app.metainfo.xml.in:31
msgid ""
"Fluent adaptive user interface for different screen (Desktop, Tablet, "
"Mobile)."
msgstr ""
"Interface utilisateur fluide et adaptable selon les formats d’écrans "
"(ordinateur, tablette, mobile)."

#: data/app.metainfo.xml.in:32
msgid "Gaussian blurred cover as background, follows GNOME light/dark mode."
msgstr ""
"Flou gaussien créé à partir de la pochette du titre pour l’arrière-plan, "
"suit le thème de couleur clair ou sombre de GNOME."

#: data/app.metainfo.xml.in:33
msgid ""
"Supports creating and editing playlists, drag cover to change order or add "
"to another playlist."
msgstr ""
"Permet de créer et modifier des listes de lecture, de déplacer un titre au "
"sein d’une même liste ou de l’ajouter à une autre en le faisant glisser."

#: data/app.metainfo.xml.in:34
msgid "Supports drag and drop with other apps."
msgstr ""
"Prend en charge le glisser-déposer pour interagir avec d’autres applications."

#: data/app.metainfo.xml.in:35
msgid "Supports audio peaks visualizer."
msgstr "Permet de visualiser les pics sonores"

#: data/app.metainfo.xml.in:36
msgid "Supports gapless playback."
msgstr "Offre une lecture sans interruption"

#: data/app.metainfo.xml.in:37
msgid "Supports normalizing volume with ReplayGain."
msgstr "Prend en charge la normalisation du volume avec ReplayGain."

#: data/app.metainfo.xml.in:38
msgid "Supports specified audio sink."
msgstr "Permet d’utiliser une sortie audio spécifiée par l’utilisateur."

#: data/app.metainfo.xml.in:39
msgid "Supports MPRIS control."
msgstr "Prend en charge le contrôle MPRIS."

#: data/app.metainfo.xml.in:50
msgid "Main window"
msgstr "Fenêtre principale"

